# Copy this file to .env and adjust as needed (see Readme.md).
# These are build-time defaults; users can override server/network at runtime
# via Settings -> Server (persisted through src/services/runtimeConfig.ts).

# LWS API endpoint. A bare host is resolved over https; include the scheme to
# force plain http, which a self-hosted or LAN light wallet server needs:
#
#   SERVER_URL=lwsapi.beldex.io            mainnet, https
#   SERVER_URL=http://192.168.1.20:8444    a private testnet on your LAN
#
# For a LAN server use the machine's IP, not localhost - the phone resolves
# this itself. Start that server with --confirm-external-bind so it listens on
# more than loopback, and --access-control-origin '*' if a browser build will
# talk to it.
SERVER_URL=lwsapi.beldex.io

# Network: 0 Mainnet, 1 Testnet, 2 Stagenet. A private testnet is 1.
NETTYPE=0

# App identity used in the User-Agent/headers
APP_NAME=Beldex Wallet
APP_VERSION=1.0.0

# Automatic fallback LWS endpoint, used when the primary SERVER_URL is
# unreachable (e.g. an ISP that blocks *.beldex.io). lwsapi.beldex.dev is
# Beldex's own alternate-domain LWS; *.beldex.dev is not blocked on Jio, so the
# wallet fails over to it with zero user action. Empty disables; or point at a
# self-hosted relay (see relay/).
FALLBACK_RELAY_URL=https://lwsapi.beldex.dev
