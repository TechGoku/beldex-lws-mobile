<?xml version="1.0" encoding="utf-8"?>
<!--
  A wallet must never have its data leave the device via cloud backup or
  device-to-device transfer. Exclude everything from both channels so seed
  keys / preferences are never exported.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
